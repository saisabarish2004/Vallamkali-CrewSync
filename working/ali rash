#!/usr/bin/env python3

"""
============================================================
coach.py
Vallamkali AI Sync Coach
============================================================

Central ESP32 sends:

    D|period,acc,angle|period,acc,angle

Example:

    D|100,28,20|105,29,21

Meaning:

    Rower 1:
        period = 100 centiseconds
        acc    = 28 / 10
        angle  = 20 degrees

    Rower 2:
        period = 105 centiseconds
        acc    = 29 / 10
        angle  = 21 degrees


Pi compares:

    Rower 2 vs Rower 1

Gemma decides whether the largest difference is significant.

Pi sends back:

    00
        everybody OK

    21
        Rower 2
        Timing fault

    22
        Rower 2
        Angle fault

    23
        Rower 2
        Power fault


============================================================
COMMANDS
============================================================

Test Gemma:

    python3 coach.py --test

Mock mode:

    python3 coach.py --mock

Real hardware:

    python3 coach.py --port /dev/ttyAMA0 --model gemma3:1b

Quiet:

    python3 coach.py --port /dev/ttyAMA0 --quiet

============================================================
"""

import argparse
import re
import sys
import time

import requests


# ============================================================
# SERIAL
# ============================================================

try:

    import serial

except ImportError:

    serial = None


# ============================================================
# OLLAMA
# ============================================================

URL = "http://127.0.0.1:11434/api/generate"

MODEL = "gemma3:1b"


# ============================================================
# GEMMA SYSTEM PROMPT
# ============================================================

SYSTEM = """
You are a rowing synchronization judge.

Two rowers should move together.

The first rower is the reference leader.
The second rower is the follower.

You receive ONE numerical difference between them.

Small differences are normal.

Return Y only when the difference is large enough
to indicate meaningful loss of synchronization.

Return N when the difference is normal.

Use these limits:

timing:
    12 or less = N
    above 12 = Y

angle:
    12 or less = N
    above 12 = Y

power:
    12 or less = N
    above 12 = Y

Examples:

timing 6 -> N
timing 30 -> Y

angle 5 -> N
angle 20 -> Y

power 8 -> N
power 25 -> Y

Answer ONLY Y or N.
"""


# ============================================================
# MEASURES
# ============================================================

MEASURES = {

    "T": (
        "timing",
        1
    ),

    "A": (
        "angle",
        2
    ),

    "P": (
        "power",
        3
    ),
}


# ============================================================
# GLOBAL STATE
# ============================================================

QUIET = False

MODEL = "gemma3:1b"

pending = None

confirmed = None

sess = requests.Session()


# ============================================================
# PRINT
# ============================================================

def say(*args):

    if not QUIET:

        print(*args)


# ============================================================
# GEMMA
# ============================================================

def ask_gemma(question):

    """
    Ask Gemma one yes/no question.

    Returns:

        True  = alert
        False = no alert
        None  = failed
    """

    body = {

        "model": MODEL,

        "system": SYSTEM,

        "prompt": question,

        "stream": False,

        "keep_alive": -1,

        "format": {
            "type": "string",
            "enum": [
                "Y",
                "N"
            ]
        },

        "options": {

            "temperature": 0,

            "top_k": 1,

            "num_predict": 3,

            "num_ctx": 256,

            "seed": 0
        }
    }

    start = time.time()

    try:

        response = sess.post(
            URL,
            json=body,
            timeout=10
        )

        response.raise_for_status()

        data = response.json()

    except Exception as e:

        say(
            "Gemma failed:",
            e
        )

        return None

    raw = data.get(
        "response",
        ""
    )

    answer = (
        raw
        .strip()
        .strip('"')
        .upper()
    )

    # Only accept a clean Y/N
    if answer == "Y":

        result = True

    elif answer == "N":

        result = False

    else:

        # Sometimes models return text like:
        # "Y\n"
        # or "The answer is Y"
        match = re.search(
            r"\b([YN])\b",
            answer
        )

        if not match:

            say(
                "Gemma returned invalid answer:",
                repr(raw)
            )

            return None

        result = (
            match.group(1) == "Y"
        )

    elapsed = (
        time.time() -
        start
    )

    say(
        f"Gemma: {raw!r} -> "
        f"{'ALERT' if result else 'NO ALERT'} "
        f"({elapsed:.2f}s)"
    )

    return result


# ============================================================
# PARSE CENTRAL MESSAGE
# ============================================================

def parse_line(line):

    """
    Parse:

        D|period,acc,angle|period,acc,angle

    Returns:

        {
            1: {"T": ..., "P": ..., "A": ...},
            2: {"T": ..., "P": ..., "A": ...}
        }

    or None.
    """

    line = line.strip()

    parts = line.split("|")

    if len(parts) != 3:

        return None

    if parts[0] != "D":

        return None

    readings = {}

    for rower_index, chunk in enumerate(
        parts[1:],
        start=1
    ):

        values = chunk.split(",")

        if len(values) != 3:

            return None

        try:

            period_cs = float(
                values[0]
            )

            acc_x10 = float(
                values[1]
            )

            angle_deg = float(
                values[2]
            )

        except ValueError:

            return None

        readings[rower_index] = {

            "T": period_cs,

            "P": acc_x10,

            "A": angle_deg
        }

    return readings


# ============================================================
# FIND WORST DIFFERENCE
# ============================================================

def worst(readings):

    """
    Compare Rower 2 with Rower 1.

    Returns:

        (target_rower, measure, signed_difference)

    Example:

        (2, "T", 25)

    means Rower 2 is 25 units different in timing.
    """

    if 1 not in readings:

        return None

    if 2 not in readings:

        return None

    best = None

    for key in MEASURES:

        follower =
            readings[2][key]

        leader =
            readings[1][key]

        difference =
            round(
                follower -
                leader
            )

        if best is None:

            best = (
                2,
                key,
                difference
            )

        elif abs(difference) > abs(best[2]):

            best = (
                2,
                key,
                difference
            )

    return best


# ============================================================
# CREATE GEMMA QUESTION
# ============================================================

def make_question(
    key,
    value
):

    label =
        MEASURES[key][0]

    return (
        f"{label} "
        f"{abs(value)}"
    )


# ============================================================
# CREATE CENTRAL COMMAND
# ============================================================

def make_packet(
    rower,
    key,
    alert
):

    """
    Returns:

        00
        21
        22
        23
    """

    if not alert:

        return "00"

    fault =
        MEASURES[key][1]

    return (
        f"{rower}"
        f"{fault}"
    )


# ============================================================
# GEMMA TESTS
# ============================================================

TESTS = [

    (
        ("T", 3),
        False
    ),

    (
        ("T", 60),
        True
    ),

    (
        ("A", 4),
        False
    ),

    (
        ("A", 25),
        True
    ),

    (
        ("P", 2),
        False
    ),

    (
        ("P", 30),
        True
    )
]


# ============================================================
# TEST GEMMA
# ============================================================

def run_tests():

    print()
    print(
        "========================================"
    )

    print(
        "          GEMMA TEST"
    )

    print(
        "========================================"
    )

    print()

    print(
        "Warming up Gemma..."
    )

    ask_gemma(
        make_question(
            "T",
            3
        )
    )

    print()

    passed = 0

    for (
        key_value,
        expected
    ) in TESTS:

        key, value = key_value

        question =
            make_question(
                key,
                value
            )

        print(
            "Test:",
            question
        )

        result =
            ask_gemma(
                question
            )

        ok =
            result == expected

        if ok:

            passed += 1

        print(
            "  ",
            "PASS" if ok else "FAIL",
            "expected=",
            "Y" if expected else "N"
        )

        print()

    print(
        f"{passed}/{len(TESTS)} tests passed"
    )

    print()


# ============================================================
# MOCK DATA
# ============================================================

def fake_lines():

    """
    Fake Rower 2 slowly drifting away.
    """

    import random

    n = 0

    while True:

        n += 1

        drift =
            min(
                50,
                5 * n
            )

        leader_period =
            100 + random.randint(
                -3,
                3
            )

        leader_acc =
            28 + random.randint(
                -2,
                2
            )

        leader_angle =
            20 + random.randint(
                -2,
                2
            )

        follower_period =
            100 + drift + random.randint(
                -3,
                3
            )

        follower_acc =
            28 + random.randint(
                -2,
                2
            )

        follower_angle =
            20 + random.randint(
                -2,
                2
            )

        line = (

            f"D|"
            f"{leader_period},"
            f"{leader_acc},"
            f"{leader_angle}|"

            f"{follower_period},"
            f"{follower_acc},"
            f"{follower_angle}"
        )

        yield line

        time.sleep(2)


# ============================================================
# SEND DECISION
# ============================================================

def send_decision(
    ser,
    packet
):

    if ser is None:

        return

    try:

        ser.write(
            (
                packet +
                "\n"
            ).encode(
                "ascii"
            )
        )

        ser.flush()

        say(
            "TX -> Central:",
            packet
        )

    except Exception as e:

        say(
            "UART write failed:",
            e
        )


# ============================================================
# MAIN
# ============================================================

def main():

    global MODEL
    global QUIET
    global pending
    global confirmed

    parser =
        argparse.ArgumentParser()

    parser.add_argument(
        "--mock",
        action="store_true"
    )

    parser.add_argument(
        "--test",
        action="store_true"
    )

    parser.add_argument(
        "--quiet",
        action="store_true"
    )

    parser.add_argument(
        "--model",
        default=MODEL
    )

    parser.add_argument(
        "--port",
        default="/dev/ttyAMA0"
    )

    parser.add_argument(
        "--baud",
        type=int,
        default=115200
    )

    args =
        parser.parse_args()

    MODEL =
        args.model

    QUIET =
        args.quiet

    # --------------------------------------------------------
    # Gemma test
    # --------------------------------------------------------

    if args.test:

        run_tests()

        return

    # --------------------------------------------------------
    # Serial
    # --------------------------------------------------------

    ser = None

    if not args.mock:

        if serial is None:

            sys.exit(
                "pyserial not installed. "
                "Run: pip install pyserial"
            )

        try:

            ser =
                serial.Serial(
                    args.port,
                    args.baud,
                    timeout=1
                )

        except Exception as e:

            sys.exit(
                f"Could not open serial "
                f"{args.port}: {e}"
            )

        say(
            f"Serial opened: "
            f"{args.port} "
            f"@ {args.baud}"
        )

    # --------------------------------------------------------
    # Warm Gemma
    # --------------------------------------------------------

    say(
        "Warming up Gemma..."
    )

    warm =
        ask_gemma(
            make_question(
                "T",
                3
            )
        )

    if warm is None:

        say(
            "WARNING: Gemma warm-up failed"
        )

    else:

        say(
            "Gemma ready"
        )

    print()

    # --------------------------------------------------------
    # Source
    # --------------------------------------------------------

    source = (
        fake_lines()
        if args.mock
        else None
    )

    # --------------------------------------------------------
    # Decision timing
    # --------------------------------------------------------

    last_analysis = 0

    ANALYSIS_INTERVAL = 2.0

    # --------------------------------------------------------
    # Main loop
    # --------------------------------------------------------

    while True:

        # ----------------------------------------------------
        # Get line
        # ----------------------------------------------------

        if args.mock:

            line =
                next(source)

        else:

            try:

                raw =
                    ser.readline()

                if not raw:

                    continue

                line =
                    raw.decode(
                        "ascii",
                        "ignore"
                    ).strip()

            except Exception as e:

                say(
                    "UART read failed:",
                    e
                )

                time.sleep(1)

                continue

        # ----------------------------------------------------
        # Parse
        # ----------------------------------------------------

        readings =
            parse_line(
                line
            )

        if readings is None:

            say(
                "Ignored:",
                repr(line)
            )

            continue

        say(
            "RX:",
            line
        )

        # ----------------------------------------------------
        # Don't ask Gemma too frequently
        # ----------------------------------------------------

        now =
            time.time()

        if (
            now -
            last_analysis <
            ANALYSIS_INTERVAL
        ):

            continue

        # ----------------------------------------------------
        # Find worst difference
        # ----------------------------------------------------

        result =
            worst(
                readings
            )

        if result is None:

            say(
                "Waiting for both rowers..."
            )

            continue

        rower, key, difference =
            result

        label =
            MEASURES[key][0]

        say(
            f"Difference: "
            f"R{rower} "
            f"{label} "
            f"{difference}"
        )

        # ----------------------------------------------------
        # IMPORTANT:
        #
        # If either rower has zero period because we don't
        # yet have a complete stroke, don't ask Gemma.
        # ----------------------------------------------------

        if (
            key == "T" and
            abs(difference) == 0
        ):

            say(
                "Timing difference is zero"
            )

        # ----------------------------------------------------
        # Ask Gemma
        # ----------------------------------------------------

        question =
            make_question(
                key,
                difference
            )

        say(
            "Gemma question:",
            question
        )

        alert =
            ask_gemma(
                question
            )

        if alert is None:

            continue

        # ----------------------------------------------------
        # Make packet
        # ----------------------------------------------------

        packet =
            make_packet(
                rower,
                key,
                alert
            )

        # ----------------------------------------------------
        # Confirmation filter
        #
        # One abnormal reading must not immediately trigger
        # the wearable.
        #
        # Same decision must occur twice.
        # ----------------------------------------------------

        if packet == pending:

            # Same decision repeated
            if packet != confirmed:

                confirmed =
                    packet

                say(
                    "CONFIRMED:",
                    packet
                )

                send_decision(
                    ser,
                    packet
                )

            else:

                say(
                    "Decision unchanged:",
                    packet
                )

        else:

            pending =
                packet

            say(
                "Waiting for same decision "
                "to repeat:",
                packet
            )

        last_analysis =
            now


# ============================================================
# PROGRAM START
# ============================================================

if __name__ == "__main__":

    try:

        main()

    except KeyboardInterrupt:

        print()
        print(
            "Coach stopped."
        )
