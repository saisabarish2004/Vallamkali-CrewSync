#!/usr/bin/env python3

"""
============================================================
coach.py
Vallamkali AI Sync Coach
============================================================

CENTRAL -> PI

D|period,acc,angle|period,acc,angle

Example:

D|100,28,20|105,30,22

Meaning:

Rower 1:
    period = 100 centiseconds
    acc    = 28
    angle  = 20

Rower 2:
    period = 105 centiseconds
    acc    = 30
    angle  = 22

PI -> CENTRAL

00 = all OK
21 = rower 2 angle fault
13 = rower 1 power fault

============================================================
"""

import argparse
import re
import sys
import time

import requests

try:
    import serial
except ImportError:
    serial = None


# ============================================================
# GEMMA
# ============================================================

URL = "http://127.0.0.1:11434/api/generate"

MODEL = "gemma3:1b"


SYSTEM = """
You are a rowing synchronization judge.

Two rowers should move together.

Rower 1 is the leader.
Rower 2 is the follower.

Small differences are normal.

The supplied number is the absolute difference
between the two rowers.

Rules:

number <= 12 = N
number > 12  = Y

Examples:

timing 6  -> N
timing 30 -> Y

angle 5   -> N
angle 20  -> Y

power 8   -> N
power 25  -> Y

Return ONLY Y or N.
"""


# ============================================================
# MEASURE DEFINITIONS
# ============================================================

MEASURES = {

    "T": (
        "timing",
        1
    ),

    "A": (
        "angle",
        2
    ),

    "P": (
        "power",
        3
    )
}


# ============================================================
# GLOBAL STATE
# ============================================================

QUIET = False

pending = None

confirmed = None

last_gemma_time = 0.0


# ============================================================
# HTTP SESSION
# ============================================================

session = requests.Session()


# ============================================================
# PRINT
# ============================================================

def say(*args):

    if not QUIET:

        print(*args, flush=True)


# ============================================================
# ASK GEMMA
# ============================================================

def ask_gemma(question):

    """
    Ask Gemma whether the supplied difference
    is large enough to trigger an alert.

    Returns:

        True  = alert
        False = no alert
        None  = failed
    """

    body = {

        "model": MODEL,

        "system": SYSTEM,

        "prompt": question,

        "stream": False,

        "keep_alive": -1,

        "format": {
            "type": "string",
            "enum": ["Y", "N"]
        },

        "options": {
            "temperature": 0,
            "top_k": 1,
            "num_predict": 3,
            "num_ctx": 256,
            "seed": 0
        }
    }

    start = time.time()

    try:

        response = session.post(
            URL,
            json=body,
            timeout=30
        )

        response.raise_for_status()

        data = response.json()

    except Exception as exc:

        say(
            "Gemma failed:",
            exc
        )

        return None

    raw = data.get(
        "response",
        ""
    )

    text = str(raw).strip().upper()

    match = re.search(
        r"\b([YN])\b",
        text
    )

    if match is None:

        # Sometimes models return just Y/N without word boundary issues
        match = re.search(
            r"[YN]",
            text
        )

    if match is None:

        say(
            f"Gemma returned invalid response: {raw!r}"
        )

        return None

    answer = (
        match.group(1) == "Y"
    )

    elapsed = (
        time.time() - start
    )

    say(
        f"Gemma: {raw!r} -> "
        f"{'ALERT' if answer else 'NO ALERT'} "
        f"({elapsed:.2f}s)"
    )

    return answer


# ============================================================
# PARSE CENTRAL DATA
# ============================================================

def parse_line(line):

    """
    Parse:

        D|period,acc,angle|period,acc,angle

    Returns:

        {
            1: {"T": ..., "P": ..., "A": ...},
            2: {"T": ..., "P": ..., "A": ...}
        }

    or None
    """

    line = line.strip()

    parts = line.split("|")

    if len(parts) != 3:

        return None

    if parts[0] != "D":

        return None

    readings = {}

    for rower_index, chunk in enumerate(
        parts[1:],
        start=1
    ):

        values = chunk.split(",")

        if len(values) != 3:

            return None

        try:

            timing = float(
                values[0]
            )

            power = float(
                values[1]
            )

            angle = float(
                values[2]
            )

        except ValueError:

            return None

        readings[rower_index] = {

            "T": timing,

            "P": power,

            "A": angle
        }

    return readings


# ============================================================
# FIND WORST DIFFERENCE
# ============================================================

def worst(readings):

    """
    Rower 1 = leader
    Rower 2 = follower

    Calculate:

        follower - leader

    for:

        timing
        power
        angle

    Return:

        (rower, measure, difference)

    """

    if 1 not in readings:

        return None

    if 2 not in readings:

        return None

    best = None

    for key in MEASURES:

        leader_value = readings[1][key]

        follower_value = readings[2][key]

        difference = round(
            follower_value - leader_value
        )

        if best is None:

            best = (
                2,
                key,
                difference
            )

        elif abs(difference) > abs(best[2]):

            best = (
                2,
                key,
                difference
            )

    return best


# ============================================================
# CREATE GEMMA QUESTION
# ============================================================

def make_question(
    key,
    value
):

    label = MEASURES[key][0]

    return f"{label} {abs(value)}"


# ============================================================
# CREATE PI -> CENTRAL PACKET
# ============================================================

def make_packet(
    rower,
    key,
    alert
):

    if not alert:

        return "00"

    fault = MEASURES[key][1]

    return f"{rower}{fault}"


# ============================================================
# TEST DATA
# ============================================================

TESTS = [

    (("T", 3), False),

    (("T", 60), True),

    (("A", 4), False),

    (("A", 25), True),

    (("P", 2), False),

    (("P", 30), True),
]


# ============================================================
# GEMMA TEST
# ============================================================

def run_tests():

    print()
    print(
        "===================================="
    )

    print(
        "GEMMA TEST"
    )

    print(
        "===================================="
    )

    passed = 0

    for (
        (key, value),
        expected
    ) in TESTS:

        question = make_question(
            key,
            value
        )

        print()
        print(
            "QUESTION:",
            question
        )

        result = ask_gemma(
            question
        )

        ok = (
            result == expected
        )

        if ok:

            passed += 1

        print(
            "RESULT:",
            "PASS" if ok else "FAIL"
        )

        print(
            "EXPECTED:",
            "ALERT" if expected else "NO ALERT"
        )

    print()
    print(
        f"{passed}/{len(TESTS)} tests passed"
    )


# ============================================================
# FAKE DATA
# ============================================================

def fake_lines():

    """
    Generate fake data.

    Rower 1 remains stable.

    Rower 2 slowly drifts.
    """

    import random

    counter = 0

    while True:

        counter += 1

        drift = min(
            50,
            5 * counter
        )

        line = (

            f"D|"
            f"{100 + random.randint(-3, 3)},"
            f"{28 + random.randint(-2, 2)},"
            f"{20 + random.randint(-2, 2)}"
            f"|"
            f"{100 + drift + random.randint(-3, 3)},"
            f"{28 + random.randint(-2, 2)},"
            f"{20 + random.randint(-2, 2)}"
        )

        yield line

        time.sleep(2)


# ============================================================
# SEND DECISION
# ============================================================

def send_decision(
    ser,
    packet
):

    if ser is None:

        return

    message = (
        packet + "\n"
    ).encode(
        "ascii"
    )

    try:

        ser.write(
            message
        )

        ser.flush()

        say(
            "TX CENTRAL:",
            packet
        )

    except Exception as exc:

        say(
            "UART write failed:",
            exc
        )


# ============================================================
# MAIN
# ============================================================

def main():

    global MODEL
    global QUIET
    global pending
    global confirmed
    global last_gemma_time

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--mock",
        action="store_true"
    )

    parser.add_argument(
        "--test",
        action="store_true"
    )

    parser.add_argument(
        "--quiet",
        action="store_true"
    )

    parser.add_argument(
        "--model",
        default=MODEL
    )

    parser.add_argument(
        "--port",
        default="/dev/ttyAMA0"
    )

    parser.add_argument(
        "--baud",
        type=int,
        default=115200
    )

    args = parser.parse_args()

    MODEL = args.model

    QUIET = args.quiet

    # --------------------------------------------------------
    # TEST MODE
    # --------------------------------------------------------

    if args.test:

        run_tests()

        return

    # --------------------------------------------------------
    # SERIAL
    # --------------------------------------------------------

    ser = None

    if not args.mock:

        if serial is None:

            sys.exit(
                "pyserial not installed. "
                "Run: pip install pyserial"
            )

        try:

            ser = serial.Serial(
                args.port,
                args.baud,
                timeout=1
            )

        except Exception as exc:

            sys.exit(
                f"Cannot open serial port "
                f"{args.port}: {exc}"
            )

        say(
            f"Serial opened: "
            f"{args.port} @ {args.baud}"
        )

    # --------------------------------------------------------
    # GEMMA WARMUP
    # --------------------------------------------------------

    say(
        "Warming up Gemma..."
    )

    warmup = ask_gemma(
        "timing 3"
    )

    if warmup is None:

        say(
            "WARNING: Gemma warmup failed."
        )

    say(
        "Coach ready."
    )

    print()

    # --------------------------------------------------------
    # MOCK
    # --------------------------------------------------------

    source = None

    if args.mock:

        source = fake_lines()

    # --------------------------------------------------------
    # DECISION TIMING
    # --------------------------------------------------------

    last_analysis = 0.0

    ANALYSIS_INTERVAL = 2.0

    # --------------------------------------------------------
    # MAIN LOOP
    # --------------------------------------------------------

    while True:

        # ====================================================
        # GET LINE
        # ====================================================

        if args.mock:

            line = next(source)

        else:

            try:

                raw = ser.readline()

            except Exception as exc:

                say(
                    "Serial read error:",
                    exc
                )

                time.sleep(1)

                continue

            if not raw:

                continue

            line = raw.decode(
                "ascii",
                "ignore"
            ).strip()

        # ====================================================
        # IGNORE EMPTY
        # ====================================================

        if not line:

            continue

        say(
            "RX:",
            line
        )

        # ====================================================
        # PARSE
        # ====================================================

        readings = parse_line(
            line
        )

        if readings is None:

            say(
                "Invalid packet - ignored"
            )

            continue

        # ====================================================
        # WAIT BETWEEN GEMMA REQUESTS
        # ====================================================

        now = time.time()

        if (
            now - last_analysis
            < ANALYSIS_INTERVAL
        ):

            continue

        # ====================================================
        # FIND WORST
        # ====================================================

        result = worst(
            readings
        )

        if result is None:

            say(
                "Waiting for both rowers..."
            )

            continue

        rower, key, difference = result

        # ====================================================
        # QUESTION
        # ====================================================

        question = make_question(
            key,
            difference
        )

        say(
            "Analysis:",
            question
        )

        # ====================================================
        # GEMMA
        # ====================================================

        alert = ask_gemma(
            question
        )

        if alert is None:

            say(
                "No decision because Gemma failed."
            )

            last_analysis = now

            continue

        # ====================================================
        # CREATE PACKET
        # ====================================================

        output = make_packet(
            rower,
            key,
            alert
        )

        # ====================================================
        # REQUIRE SAME VERDICT TWICE
        # ====================================================

        if output == pending:

            if output != confirmed:

                confirmed = output

                say(
                    "CONFIRMED:",
                    output
                )

                send_decision(
                    ser,
                    output
                )

            else:

                say(
                    "Decision unchanged:",
                    output
                )

        else:

            pending = output

            say(
                "Pending:",
                output,
                "(waiting for repeat)"
            )

        last_analysis = now


# ============================================================
# PROGRAM ENTRY
# ============================================================

if __name__ == "__main__":

    try:

        main()

    except KeyboardInterrupt:

        print()
        print(
            "Coach stopped."
        )
