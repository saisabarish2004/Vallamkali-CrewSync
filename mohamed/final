  uint8_t rower,
  uint8_t status,
  uint8_t error,
  uint8_t led
)
{
  uint8_t *mac =
    getRoverMAC(rower);


  if (mac == NULL)
  {
    Serial.println(
      "ERROR : INVALID ROVER"
    );

    return;
  }


  DecisionPacket decision;


  decision.target =
    rower;


  decision.status =
    status;


  decision.error =
    error;


  decision.led =
    led;


  esp_err_t result =
    esp_now_send(
      mac,
      (uint8_t *)&decision,
      sizeof(decision)
    );


  Serial.println();

  Serial.println(
    "----------- DECISION SENT -----------"
  );


  Serial.print(
    "Target Rover : "
  );

  Serial.println(
    rower
  );


  if (status == STATUS_CORRECT)
  {
    Serial.println(
      "Status       : CORRECT"
    );
  }
  else
  {
    Serial.println(
      "Status       : OUT_OF_SYNC"
    );
  }


  if (led == LED_COMMAND_GREEN)
  {
    Serial.println(
      "LED          : GREEN"
    );
  }
  else if (led == LED_COMMAND_RED)
  {
    Serial.println(
      "LED          : RED"
    );
  }
  else
  {
    Serial.println(
      "LED          : OFF"
    );
  }


  Serial.print(
    "Error code   : "
  );

  Serial.println(
    error
  );


  if (result == ESP_OK)
  {
    Serial.println(
      "ESP-NOW      : QUEUED"
    );
  }
  else
  {
    Serial.println(
      "ESP-NOW      : FAILED"
    );
  }


  Serial.println(
    "--------------------------------------"
  );
}


// =====================================================
// ANALYZE STROKE
// =====================================================

void analyzeStroke(
  StrokePacket &packet
)
{
  // ===================================================
  // CHECK 1 - DURATION
  // ===================================================

  bool durationOK =
    (
      packet.duration_ms >=
      MIN_DURATION
    )
    &&
    (
      packet.duration_ms <=
      MAX_DURATION
    );


  // ===================================================
  // CHECK 2 - PEAK ACCELERATION
  // ===================================================

  bool accelerationOK =
    (
      packet.peak_acc >=
      MIN_PEAK_ACC
    )
    &&
    (
      packet.peak_acc <=
      MAX_PEAK_ACC
    );


  // ===================================================
  // CHECK 3 - GYRO
  // ===================================================

  bool gyroOK =
    (
      packet.gyro_peak >=
      MIN_GYRO_PEAK
    )
    &&
    (
      packet.gyro_peak <=
      MAX_GYRO_PEAK
    );


  // ===================================================
  // CHECK 4 - ANGLE
  // ===================================================

  bool angleOK =
    (
      packet.angle >=
      MIN_ANGLE
    )
    &&
    (
      packet.angle <=
      MAX_ANGLE
    );


  // ===================================================
  // DISPLAY RECEIVED VALUES
  // ===================================================

  Serial.println();

  Serial.println(
    "========================================"
  );

  Serial.print(
    "        ROVER "
  );

  Serial.print(
    packet.rower
  );

  Serial.println(
    " STROKE ANALYSIS"
  );

  Serial.println(
    "========================================"
  );


  Serial.print(
    "Stroke ID       : "
  );

  Serial.println(
    packet.stroke_id
  );


  Serial.println();


  // ===================================================
  // PARAMETER 1
  // ===================================================

  Serial.print(
    "Duration        : "
  );

  Serial.print(
    packet.duration_ms
  );

  Serial.print(
    " ms  [700-1400] -> "
  );

  Serial.println(
    durationOK ?
    "PASS" :
    "FAIL"
  );


  // ===================================================
  // PARAMETER 2
  // ===================================================

  Serial.print(
    "Peak Acc        : "
  );

  Serial.print(
    packet.peak_acc,
    2
  );

  Serial.print(
    " m/s2 [1.5-5.0] -> "
  );

  Serial.println(
    accelerationOK ?
    "PASS" :
    "FAIL"
  );


  // ===================================================
  // PARAMETER 3
  // ===================================================

  Serial.print(
    "Gyro Peak       : "
  );

  Serial.print(
    packet.gyro_peak,
    2
  );

  Serial.print(
    " deg/s [40-180] -> "
  );

  Serial.println(
    gyroOK ?
    "PASS" :
    "FAIL"
  );


  // ===================================================
  // PARAMETER 4
  // ===================================================

  Serial.print(
    "Angle           : "
  );

  Serial.print(
    packet.angle,
    2
  );

  Serial.print(
    " deg [20-60] -> "
  );

  Serial.println(
    angleOK ?
    "PASS" :
    "FAIL"
  );


  Serial.println(
    "----------------------------------------"
  );


  // ===================================================
  // FINAL DECISION
  // ===================================================

  if (
    durationOK &&
    accelerationOK &&
    gyroOK &&
    angleOK
  )
  {
    // ================================================
    // CORRECT
    // ================================================

    Serial.println(
      "ALL 4 PARAMETERS : PASS"
    );

    Serial.println(
      "RESULT           : CORRECT"
    );

    Serial.println(
      "STATUS           : CORRECT"
    );

    Serial.println(
      "LED              : GREEN"
    );

    Serial.println(
      "ERROR            : NONE"
    );


    sendDecision(
      packet.rower,
      STATUS_CORRECT,
      ERROR_NONE,
      LED_COMMAND_GREEN
    );
  }


  else
  {
    // ================================================
    // WRONG
    // ================================================

    Serial.println(
      "ALL 4 PARAMETERS : NOT PASS"
    );

    Serial.println(
      "RESULT           : WRONG"
    );

    Serial.println(
      "STATUS           : OUT_OF_SYNC"
    );

    Serial.println(
      "LED              : RED"
    );


    // ================================================
    // SHOW EVERY FAILED PARAMETER
    // ================================================

    if (!durationOK)
    {
      Serial.println(
        "ISSUE            : WRONG DURATION"
      );
    }


    if (!accelerationOK)
    {
      Serial.println(
        "ISSUE            : WRONG PEAK ACCELERATION"
      );
    }


    if (!gyroOK)
    {
      Serial.println(
        "ISSUE            : WRONG GYRO PEAK"
      );
    }


    if (!angleOK)
    {
      Serial.println(
        "ISSUE            : WRONG ANGLE"
      );
    }


    // Send one RED decision
    // Error code identifies the first failed parameter.

    uint8_t errorCode =
      ERROR_NONE;


    if (!durationOK)
    {
      errorCode =
        ERROR_DURATION;
    }
    else if (!accelerationOK)
    {
      errorCode =
        ERROR_ACCELERATION;
    }
    else if (!gyroOK)
    {
      errorCode =
        ERROR_GYRO;
    }
    else if (!angleOK)
    {
      errorCode =
        ERROR_ANGLE;
    }


    sendDecision(
      packet.rower,
      STATUS_OUT_OF_SYNC,
      errorCode,
      LED_COMMAND_RED
    );
  }


  Serial.println(
    "========================================"
  );
}


// =====================================================
// RECEIVE DATA FROM ROVERS
// =====================================================

void onDataReceive(
  const esp_now_recv_info_t *info,
  const uint8_t *data,
  int len
)
{
  // ===================================================
  // CHECK PACKET SIZE
  // ===================================================

  if (
    len != sizeof(StrokePacket)
  )
  {
    Serial.println(
      "INVALID PACKET SIZE"
    );

    return;
  }


  StrokePacket packet;


  memcpy(
    &packet,
    data,
    sizeof(packet)
  );


  // ===================================================
  // CHECK PACKET TYPE
  // ===================================================

  if (
    packet.type !=
    PACKET_TYPE_STROKE
  )
  {
    Serial.println(
      "UNKNOWN PACKET TYPE"
    );

    return;
  }


  // ===================================================
  // CHECK ROVER ID
  // ===================================================

  if (
    packet.rower < 1 ||
    packet.rower > 3
  )
  {
    Serial.println(
      "INVALID ROVER ID"
    );

    return;
  }


  // ===================================================
  // PROCESS
  // ===================================================

  Serial.println();

  Serial.println(
    "########################################"
  );

  Serial.print(
    "STROKE RECEIVED FROM ROVER "
  );

  Serial.println(
    packet.rower
  );

  Serial.println(
    "########################################"
  );


  analyzeStroke(
    packet
  );
}


// =====================================================
// SEND CALLBACK
// =====================================================

void onDataSent(
  const wifi_tx_info_t *info,
  esp_now_send_status_t status
)
{
  // Keep silent.
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);


  // ===================================================
  // WIFI
  // ===================================================

  WiFi.mode(WIFI_STA);


  // ===================================================
  // CENTRAL INFORMATION
  // ===================================================

  Serial.println();

  Serial.println(
    "========================================"
  );

  Serial.println(
    "           CENTRAL ESP32"
  );

  Serial.println(
    "          3 ROVER SYSTEM"
  );

  Serial.println(
    "========================================"
  );


  Serial.print(
    "Central MAC : "
  );

  Serial.println(
    WiFi.macAddress()
  );


  // ===================================================
  // ESP-NOW
  // ===================================================

  if (
    esp_now_init() != ESP_OK
  )
  {
    Serial.println(
      "ESP-NOW INIT FAILED"
    );

    while (true)
    {
      delay(1000);
    }
  }


  Serial.println(
    "ESP-NOW INIT OK"
  );


  // ===================================================
  // CALLBACKS
  // ===================================================

  esp_now_register_recv_cb(
    onDataReceive
  );

  esp_now_register_send_cb(
    onDataSent
  );


  // ===================================================
  // ADD ROVERS
  // ===================================================

  addRover(
    1,
    ROVER1_MAC
  );

  addRover(
    2,
    ROVER2_MAC
  );

  addRover(
    3,
    ROVER3_MAC
  );


  // ===================================================
  // SHOW CONDITIONS
  // ===================================================

  Serial.println();

  Serial.println(
    "CORRECT STROKE CONDITIONS"
  );

  Serial.println(
    "Duration   : 700 - 1400 ms"
  );

  Serial.println(
    "Peak Acc   : 1.5 - 5.0 m/s2"
  );

  Serial.println(
    "Gyro Peak  : 40 - 180 deg/s"
  );

  Serial.println(
    "Angle      : 20 - 60 deg"
  );


  Serial.println();

  Serial.println(
    "ALL 4 MUST PASS"
  );

  Serial.println(
    "GREEN = CORRECT"
  );

  Serial.println(
    "RED   = WRONG"
  );

  Serial.println();

  Serial.println(
    "CENTRAL READY"
  );
}


