#define LED_COMMAND_GREEN  1
#define LED_COMMAND_RED    2


// =====================================================
// MPU READ
// =====================================================

int16_t read16(uint8_t reg)
{
  Wire.beginTransmission(MPU_ADDR);

  Wire.write(reg);

  Wire.endTransmission(false);

  Wire.requestFrom(
    MPU_ADDR,
    (uint8_t)2
  );

  if (Wire.available() < 2)
  {
    return 0;
  }

  uint8_t highByte = Wire.read();

  uint8_t lowByte = Wire.read();

  return (int16_t)((highByte << 8) | lowByte);
}


// =====================================================
// MPU REGISTER WRITE
// =====================================================

void writeRegister(
  uint8_t reg,
  uint8_t value
)
{
  Wire.beginTransmission(MPU_ADDR);

  Wire.write(reg);

  Wire.write(value);

  Wire.endTransmission();
}


// =====================================================
// LED OFF
// =====================================================

void ledOff()
{
  digitalWrite(RED_PIN, LOW);

  digitalWrite(GREEN_PIN, LOW);

  digitalWrite(BLUE_PIN, LOW);

  currentLED = LED_OFF;
}


// =====================================================
// GREEN LED
// =====================================================

void ledGreen()
{
  digitalWrite(RED_PIN, LOW);

  digitalWrite(GREEN_PIN, HIGH);

  digitalWrite(BLUE_PIN, LOW);

  currentLED = LED_GREEN;
}


// =====================================================
// RED LED
// =====================================================

void ledRed()
{
  digitalWrite(RED_PIN, HIGH);

  digitalWrite(GREEN_PIN, LOW);

  digitalWrite(BLUE_PIN, LOW);

  currentLED = LED_RED;
}


// =====================================================
// RECEIVE DECISION FROM CENTRAL
// =====================================================

void onDataReceive(
  const esp_now_recv_info_t *info,
  const uint8_t *data,
  int len
)
{
  if (len != sizeof(DecisionPacket))
  {
    return;
  }


  DecisionPacket decision;

  memcpy(
    &decision,
    data,
    sizeof(decision)
  );


  if (decision.target != ROWER_ID)
  {
    return;
  }


  Serial.println();
  Serial.println(
    "========================================"
  );

  Serial.println(
    "       DECISION FROM CENTRAL"
  );

  Serial.println(
    "========================================"
  );


  // ===================================================
  // CORRECT
  // ===================================================

  if (
    decision.status ==
    STATUS_CORRECT
  )
  {
    ledGreen();

    Serial.println(
      "RESULT : CORRECT"
    );

    Serial.println(
      "LED    : GREEN"
    );

    Serial.println(
      "ERROR  : NONE"
    );
  }


  // ===================================================
  // WRONG
  // ===================================================

  else if (
    decision.status ==
    STATUS_WRONG
  )
  {
    ledRed();

    Serial.println(
      "RESULT : WRONG"
    );

    Serial.println(
      "LED    : RED"
    );
  }


  // ===================================================
  // OUT OF SYNC
  // ===================================================

  else if (
    decision.status ==
    STATUS_OUT_OF_SYNC
  )
  {
    ledRed();

    Serial.println(
      "RESULT : OUT_OF_SYNC"
    );

    Serial.println(
      "LED    : RED"
    );
  }


  // ===================================================
  // ERROR REASON
  // ===================================================

  Serial.print(
    "ERROR CODE : "
  );

  Serial.println(
    decision.error
  );


  Serial.println(
    "========================================"
  );
}


