// =====================================================
// SEND STROKE PACKET
// =====================================================

void sendStrokePacket(
  unsigned long duration
)
{
  StrokePacket packet;


  packet.type =
    PACKET_TYPE_STROKE;


  packet.rower =
    ROWER_ID;


  packet.stroke_id =
    strokeID++;


  packet.duration_ms =
    duration;


  packet.peak_acc =
    peakAcceleration;


  packet.gyro_peak =
    peakGyro;


  packet.angle =
    peakAngle;


  esp_err_t result =
    esp_now_send(
      centralMAC,
      (uint8_t *)&packet,
      sizeof(packet)
    );


  // ===================================================
  // PRINT STROKE PACKET
  // ===================================================

  Serial.println();

  Serial.println(
    "========================================"
  );

  Serial.println(
    "          STROKE PACKET"
  );

  Serial.println(
    "========================================"
  );


  Serial.print(
    "Type       : STROKE"
  );

  Serial.println();


  Serial.print(
    "Rower      : "
  );

  Serial.println(
    packet.rower
  );


  Serial.print(
    "Stroke ID  : "
  );

  Serial.println(
    packet.stroke_id
  );


  Serial.print(
    "Duration   : "
  );

  Serial.print(
    packet.duration_ms
  );

  Serial.println(
    " ms"
  );


  Serial.print(
    "Peak Acc   : "
  );

  Serial.print(
    packet.peak_acc,
    2
  );

  Serial.println(
    " m/s2"
  );


  Serial.print(
    "Gyro Peak  : "
  );

  Serial.print(
    packet.gyro_peak,
    2
  );

  Serial.println(
    " deg/s"
  );


  Serial.print(
    "Angle      : "
  );

  Serial.print(
    packet.angle,
    2
  );

  Serial.println(
    " deg"
  );


  if (result == ESP_OK)
  {
    Serial.println(
      "ESP-NOW    : SENT"
    );
  }
  else
  {
    Serial.println(
      "ESP-NOW    : FAILED"
    );
  }


  Serial.println(
    "========================================"
  );
}


// =====================================================
// START STROKE
// =====================================================

void startStroke()
{
  strokeActive = true;

  strokeStartTime =
    millis();


  lastMotionTime =
    millis();


  peakAcceleration =
    dynamicAcceleration;


  peakGyro =
    gyroMagnitude;


  peakAngle =
    currentAngle;


  Serial.println();

  Serial.println(
    ">>> STROKE STARTED <<<"
  );
}


// =====================================================
// UPDATE ACTIVE STROKE
// =====================================================

void updateStroke()
{
  // Update peaks

  if (
    dynamicAcceleration >
    peakAcceleration
  )
  {
    peakAcceleration =
      dynamicAcceleration;
  }


  if (
    gyroMagnitude >
    peakGyro
  )
  {
    peakGyro =
      gyroMagnitude;
  }


  if (
    currentAngle >
    peakAngle
  )
  {
    peakAngle =
      currentAngle;
  }


  // ---------------------------------------------------
  // Motion still happening
  // ---------------------------------------------------

  if (
    dynamicAcceleration >
      STROKE_END_ACC
    ||
    gyroMagnitude >
      STROKE_END_GYRO
  )
  {
    lastMotionTime =
      millis();
  }


  // ---------------------------------------------------
  // Check for stroke completion
  // ---------------------------------------------------

  if (
    millis() - lastMotionTime >
    200
  )
  {
    finishStroke();
  }


  // ---------------------------------------------------
  // Safety timeout
  // ---------------------------------------------------

  if (
    millis() - strokeStartTime >
    MAX_STROKE_DURATION
  )
  {
    finishStroke();
  }
}


// =====================================================
// FINISH STROKE
// =====================================================

void finishStroke()
{
  if (!strokeActive)
  {
    return;
  }


  strokeActive = false;


  unsigned long duration =
    millis() -
    strokeStartTime;


  if (
    duration >=
    MIN_STROKE_DURATION
  )
  {
    sendStrokePacket(
      duration
    );
  }
  else
  {
    Serial.println(
      "Stroke ignored: too short"
    );
  }


  lastStrokeEndTime =
    millis();
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);


  // ===================================================
  // LED
  // ===================================================

  pinMode(
    RED_PIN,
    OUTPUT
  );

  pinMode(
    GREEN_PIN,
    OUTPUT
  );

  pinMode(
    BLUE_PIN,
    OUTPUT
  );


  ledOff();


  // ===================================================
  // I2C
  // ===================================================

  Wire.begin(
    SDA_PIN,
    SCL_PIN
  );


  // ===================================================
  // MPU
  // ===================================================

  writeRegister(
    PWR_MGMT_1,
    0x00
  );


  delay(1000);


  // ===================================================
  // WIFI
  // ===================================================

  WiFi.mode(WIFI_STA);


  // ===================================================
  // ROVER INFO
  // ===================================================

  Serial.println();

  Serial.println(
    "========================================"
  );

  Serial.println(
    "             ROVER 2"
  );

  Serial.println(
    "========================================"
  );


  Serial.print(
    "MAC : "
  );

  Serial.println(
    WiFi.macAddress()
  );


  // ===================================================
  // ESP-NOW
  // ===================================================

  if (
    esp_now_init() != ESP_OK
  )
  {
    Serial.println(
      "ESP-NOW INIT FAILED"
    );

    return;
  }


  Serial.println(
    "ESP-NOW INIT OK"
  );


  esp_now_register_recv_cb(
    onDataReceive
  );


  esp_now_register_send_cb(
    onDataSent
  );


  // ===================================================
  // ADD CENTRAL
  // ===================================================

  esp_now_peer_info_t peerInfo = {};


  memcpy(
    peerInfo.peer_addr,
    centralMAC,
    6
  );


  peerInfo.channel = 0;

  peerInfo.encrypt = false;


  if (
    esp_now_add_peer(
      &peerInfo
    ) == ESP_OK
  )
  {
    Serial.println(
      "CENTRAL PEER : ADDED"
    );
  }
  else
  {
    Serial.println(
      "CENTRAL PEER : FAILED"
    );
  }


  Serial.println();

  Serial.println(
    "ROVER 1 READY"
  );
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  unsigned long now =
    millis();


  // ===================================================
  // SENSOR SAMPLE
  // ===================================================

  if (
    now - lastSensorTime >=
    SENSOR_INTERVAL
  )
  {
    lastSensorTime =
      now;


    // ================================================
    // RAW ACCEL
    // ================================================

    int16_t rawAX =
      read16(
        ACCEL_XOUT_H
      );


    int16_t rawAY =
      read16(
        ACCEL_XOUT_H + 2
      );


    int16_t rawAZ =
      read16(
        ACCEL_XOUT_H + 4
      );


    // ================================================
    // RAW GYRO
    // ================================================

    int16_t rawGX =
      read16(
        GYRO_XOUT_H
      );


    int16_t rawGY =
      read16(
        GYRO_XOUT_H + 2
      );


    int16_t rawGZ =
      read16(
        GYRO_XOUT_H + 4
      );


    // ================================================
    // ACCEL CONVERSION
    // ================================================

    currentAX =
      (rawAX /
       ACCEL_SCALE_X)
      * GRAVITY;


    currentAY =
      (rawAY /
       ACCEL_SCALE_Y)
      * GRAVITY;


    float zG =
      (rawAZ -
       Z_OFFSET)
      / Z_SCALE;


    currentAZ =
      zG *
      GRAVITY;


    // ================================================
    // GYRO CONVERSION
    // ================================================

    currentGX =
      (rawGX /
       GYRO_SCALE)
      - GYRO_BIAS_X;


    currentGY =
      (rawGY /
       GYRO_SCALE)
      - GYRO_BIAS_Y;


    currentGZ =
      (rawGZ /
       GYRO_SCALE)
      - GYRO_BIAS_Z;


    // ================================================
    // ACCEL MAGNITUDE
    // ================================================

    float accelerationMagnitude =
      sqrt(
        currentAX * currentAX +
        currentAY * currentAY +
        currentAZ * currentAZ
      );


    // ================================================
    // DYNAMIC ACCELERATION
    // ================================================

    dynamicAcceleration =
      fabs(
        accelerationMagnitude -
        GRAVITY
      );


    // ================================================
    // GYRO MAGNITUDE
    // ================================================

    gyroMagnitude =
      sqrt(
        currentGX * currentGX +
        currentGY * currentGY +
        currentGZ * currentGZ
      );


    // ================================================
    // ANGLE
    // ================================================

    currentAngle =
      atan2(
        sqrt(
          currentAX * currentAX +
          currentAY * currentAY
        ),
        fabs(currentAZ)
      )
      * 180.0 /
      PI;


    // ================================================
    // START STROKE
    // ================================================

    if (!strokeActive)
    {
      if (
        now - lastStrokeEndTime >=
        STROKE_COOLDOWN
      )
      {
        if (
          dynamicAcceleration >
          STROKE_START_ACC
          ||
          gyroMagnitude >
          STROKE_START_GYRO
        )
        {
          startStroke();
        }
      }
    }


    // ================================================
    // UPDATE STROKE
    // ================================================

    else
    {
      updateStroke();
    }


    // ================================================
    // SERIAL DISPLAY
    // ================================================

    if (
      now - lastDisplayTime >=
      DISPLAY_INTERVAL
    )
    {
      lastDisplayTime =
        now;


      Serial.println();

      Serial.println(
        "========================================"
      );

      Serial.println(
        "             ROVER 2 DATA"
      );

      Serial.println(
        "========================================"
      );


      Serial.print(
        "AX : "
      );

      Serial.print(
        currentAX,
        2
      );

      Serial.println(
        " m/s2"
      );


      Serial.print(
        "AY : "
      );

      Serial.print(
        currentAY,
        2
      );

      Serial.println(
        " m/s2"
      );


      Serial.print(
        "AZ : "
      );

      Serial.print(
        currentAZ,
        2
      );

      Serial.println(
        " m/s2"
      );


      Serial.print(
        "GX : "
      );

      Serial.print(
        currentGX,
        2
      );

      Serial.println(
        " deg/s"
      );


      Serial.print(
        "GY : "
      );

      Serial.print(
        currentGY,
        2
      );

      Serial.println(
        " deg/s"
      );


      Serial.print(
        "GZ : "
      );

      Serial.print(
        currentGZ,
        2
      );

      Serial.println(
        " deg/s"
      );


      Serial.println();


      Serial.print(
        "Dynamic Acc : "
      );

      Serial.print(
        dynamicAcceleration,
        2
      );

      Serial.println(
        " m/s2"
      );


      Serial.print(
        "Gyro Mag    : "
      );

      Serial.print(
        gyroMagnitude,
        2
      );

      Serial.println(
        " deg/s"
      );


      Serial.print(
        "Angle       : "
      );

      Serial.print(
        currentAngle,
        2
      );

      Serial.println(
        " deg"
      );


      Serial.println();


      if (strokeActive)
      {
        Serial.println(
          "STROKE : IN PROGRESS"
        );
      }
      else
      {
        Serial.println(
          "STROKE : IDLE"
        );
      }


      Serial.print(
        "LED : "
      );


      if (
        currentLED ==
        LED_GREEN
      )
      {
        Serial.println(
          "GREEN"
        );
      }

      else if (
        currentLED ==
        LED_RED
      )
      {
        Serial.println(
          "RED"
        );
      }

      else
      {
        Serial.println(
          "OFF"
        );
      }


      Serial.println(
        "========================================"
      );
    }
  }
}

