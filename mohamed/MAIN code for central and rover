#include <WiFi.h>
#include <esp_now.h>

// ======================================
// CENTRAL ESP32 MAC ADDRESS
// ======================================

uint8_t centralMAC[] = {
  0x94, 0x54, 0xC5, 0x2F, 0x27, 0x28
};


// ======================================
// Motion Packet
// ======================================

typedef struct {

  uint8_t rower_id;
  uint32_t sequence;
  uint32_t timestamp;

  float ax;
  float ay;
  float az;

  float gx;
  float gy;
  float gz;

} MotionPacket;

MotionPacket packet;

uint32_t sequenceNumber = 0;


// ======================================
// ESP-NOW SEND CALLBACK
// ======================================

void onDataSent(const wifi_tx_info_t *info,
                esp_now_send_status_t status) {

  // IMPORTANT:
  // Do not print anything here for this test.
}


// ======================================
// SETUP
// ======================================

void setup() {

  // Serial is NOT required for communication.
  // We leave it here only for optional debugging.
  Serial.begin(115200);

  delay(1000);

  WiFi.mode(WIFI_STA);

  // ESP-NOW
  if (esp_now_init() != ESP_OK) {
    return;
  }

  esp_now_register_send_cb(onDataSent);


  // Add Central as peer

  esp_now_peer_info_t peerInfo = {};

  memcpy(peerInfo.peer_addr, centralMAC, 6);

  peerInfo.channel = 0;

  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    return;
  }
}


// ======================================
// LOOP
// ======================================

void loop() {

  packet.rower_id = 2;

  packet.sequence = sequenceNumber++;

  packet.timestamp = millis();

  // Dummy IMU data

  packet.ax = 1.2;
  packet.ay = 0.4;
  packet.az = 9.8;

  packet.gx = 0.1;
  packet.gy = 0.2;
  packet.gz = 0.3;


  // Send packet

  esp_now_send(
    centralMAC,
    (uint8_t *)&packet,
    sizeof(packet)
  );


  // Exactly 500 ms

  delay(500);
}
