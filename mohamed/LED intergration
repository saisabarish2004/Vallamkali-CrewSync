#include <WiFi.h>
#include <esp_now.h>


// =====================================================
// CHANGE THIS FOR EACH XIAO
// =====================================================

#define ROWER_ID 1


// =====================================================
// CENTRAL ESP32 MAC ADDRESS
// =====================================================

uint8_t centralMAC[] = {
  0x94, 0x54, 0xC5, 0x2F, 0x27, 0x28
};


// =====================================================
// RGB LED PINS
// =====================================================

#define RED_PIN    3
#define GREEN_PIN  4
#define BLUE_PIN   5


// =====================================================
// MOTION PACKET
// XIAO -> CENTRAL
// =====================================================

typedef struct {

  uint8_t rower_id;

  uint32_t sequence;

  uint32_t timestamp;

  float ax;
  float ay;
  float az;

  float gx;
  float gy;
  float gz;

} MotionPacket;


MotionPacket motionPacket;

uint32_t sequenceNumber = 0;


// =====================================================
// COMMAND PACKET
// CENTRAL -> XIAO
// =====================================================
//
// instruction:
// 1 = SPEED
// 2 = TIME
// 3 = RESET / LED OFF
//
// =====================================================

typedef struct {

  uint8_t rower_id;

  uint8_t instruction;

} CommandPacket;


CommandPacket command;


// =====================================================
// RED LED
// =====================================================

void redLED() {

  digitalWrite(
    RED_PIN,
    HIGH
  );

  digitalWrite(
    GREEN_PIN,
    LOW
  );

  digitalWrite(
    BLUE_PIN,
    LOW
  );
}


// =====================================================
// GREEN LED
// =====================================================

void greenLED() {

  digitalWrite(
    RED_PIN,
    LOW
  );

  digitalWrite(
    GREEN_PIN,
    HIGH
  );

  digitalWrite(
    BLUE_PIN,
    LOW
  );
}


// =====================================================
// BLUE LED
// =====================================================

void blueLED() {

  digitalWrite(
    RED_PIN,
    LOW
  );

  digitalWrite(
    GREEN_PIN,
    LOW
  );

  digitalWrite(
    BLUE_PIN,
    HIGH
  );
}


// =====================================================
// LED OFF
// =====================================================

void offLED() {

  digitalWrite(
    RED_PIN,
    LOW
  );

  digitalWrite(
    GREEN_PIN,
    LOW
  );

  digitalWrite(
    BLUE_PIN,
    LOW
  );
}


// =====================================================
// RECEIVE COMMAND
// CENTRAL -> XIAO
// =====================================================

void onDataReceive(
  const esp_now_recv_info_t *info,
  const uint8_t *data,
  int len
) {

  // =================================================
  // CHECK PACKET SIZE
  // =================================================

  if (len != sizeof(CommandPacket)) {

    return;
  }


  // =================================================
  // COPY COMMAND
  // =================================================

  memcpy(
    &command,
    data,
    sizeof(command)
  );


  // =================================================
  // IGNORE OTHER ROWERS
  // =================================================

  if (command.rower_id != ROWER_ID) {

    return;
  }


  // =================================================
  // SPEED -> RED
  // =================================================

  if (command.instruction == 1) {

    redLED();
  }


  // =================================================
  // TIME -> GREEN
  // =================================================

  else if (command.instruction == 2) {

    greenLED();
  }


  // =================================================
  // RESET -> OFF
  // =================================================

  else if (command.instruction == 3) {

    offLED();
  }


  // =================================================
  // UNKNOWN -> OFF
  // =================================================

  else {

    offLED();
  }
}


// =====================================================
// SEND CALLBACK
// =====================================================

void onDataSent(
  const wifi_tx_info_t *info,
  esp_now_send_status_t status
) {

  // No Serial printing.
  // Keeps the XIAO communication fast.
}


// =====================================================
// SETUP
// =====================================================

void setup() {

  // =================================================
  // RGB LED
  // =================================================

  pinMode(
    RED_PIN,
    OUTPUT
  );

  pinMode(
    GREEN_PIN,
    OUTPUT
  );

  pinMode(
    BLUE_PIN,
    OUTPUT
  );


  // LED initially OFF

  offLED();


  // =================================================
  // WIFI
  // =================================================

  WiFi.mode(
    WIFI_STA
  );


  // =================================================
  // ESP-NOW INITIALIZATION
  // =================================================

  if (
    esp_now_init() != ESP_OK
  ) {

    return;
  }


  // =================================================
  // RECEIVE CALLBACK
  // =================================================

  esp_now_register_recv_cb(
    onDataReceive
  );


  // =================================================
  // SEND CALLBACK
  // =================================================

  esp_now_register_send_cb(
    onDataSent
  );


  // =================================================
  // ADD CENTRAL AS PEER
  // =================================================

  esp_now_peer_info_t peerInfo = {};


  memcpy(
    peerInfo.peer_addr,
    centralMAC,
    6
  );


  peerInfo.channel = 0;

  peerInfo.encrypt = false;


  esp_now_add_peer(
    &peerInfo
  );
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  // =================================================
  // CREATE MOTION PACKET
  // =================================================

  motionPacket.rower_id =
    ROWER_ID;


  motionPacket.sequence =
    sequenceNumber++;


  motionPacket.timestamp =
    millis();


  // =================================================
  // FAKE IMU DATA
  // Replace with real IMU later
  // =================================================

  motionPacket.ax = 1.2;

  motionPacket.ay = 0.4;

  motionPacket.az = 9.8;


  motionPacket.gx = 0.1;

  motionPacket.gy = 0.2;

  motionPacket.gz = 0.3;


  // =================================================
  // SEND MOTION PACKET
  // XIAO -> CENTRAL
  // =================================================

  esp_now_send(

    centralMAC,

    (uint8_t *)&motionPacket,

    sizeof(motionPacket)

  );


  // =================================================
  // TRANSMIT EVERY 500 ms
  // =================================================

  delay(500);
}
