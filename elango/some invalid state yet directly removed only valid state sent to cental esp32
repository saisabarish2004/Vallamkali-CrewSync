#include <Wire.h>
#include <math.h>

// =====================================================
// MPU6050
// =====================================================

#define MPU_ADDR 0x68

#define ACCEL_XOUT_H 0x3B
#define GYRO_XOUT_H  0x43
#define PWR_MGMT_1   0x6B

// =====================================================
// ROWER ID
// =====================================================

#define ROWER_ID 1

// =====================================================
// GRAVITY
// =====================================================

const float GRAVITY = 9.80665;

// =====================================================
// ACCELEROMETER CALIBRATION
// =====================================================

const float ACCEL_SCALE_X = 16384.0;
const float ACCEL_SCALE_Y = 16384.0;

const float Z_OFFSET = 3029.0;
const float Z_SCALE  = 16448.0;

// =====================================================
// GYROSCOPE CALIBRATION
// =====================================================

const float GYRO_BIAS_X = 1.93;
const float GYRO_BIAS_Y = 0.76;
const float GYRO_BIAS_Z = -0.27;

const float GYRO_SCALE = 131.0;

// =====================================================
// STROKE DETECTION
// =====================================================

// Movement required to START a stroke
const float START_ACC_THRESHOLD  = 4.0;
const float START_GYRO_THRESHOLD = 50.0;

// Valid stroke limits
const unsigned long MIN_STROKE_DURATION = 500;
const unsigned long MAX_STROKE_DURATION = 2000;

// Required peak values
const float MIN_PEAK_ACC  = 4.0;
const float MIN_PEAK_GYRO = 50.0;

// Movement considered stopped
const float END_ACC_THRESHOLD  = 1.5;
const float END_GYRO_THRESHOLD = 15.0;

// =====================================================
// STROKE STATE
// =====================================================

bool strokeActive = false;

unsigned long strokeStartTime = 0;

float peakAcceleration = 0.0;
float peakGyroscope = 0.0;

float startAx = 0.0;
float startAy = 0.0;
float startAz = 0.0;

uint32_t strokeID = 0;

// =====================================================
// READ 16-BIT MPU VALUE
// =====================================================

int16_t read16(uint8_t reg)
{
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, (uint8_t)2);

  if (Wire.available() < 2)
  {
    return 0;
  }

  uint8_t highByte = Wire.read();
  uint8_t lowByte  = Wire.read();

  return (int16_t)((highByte << 8) | lowByte);
}

// =====================================================
// WRITE MPU REGISTER
// =====================================================

void writeRegister(uint8_t reg, uint8_t value)
{
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(2000);

  Wire.begin(21, 22);

  // Wake MPU6050
  writeRegister(PWR_MGMT_1, 0x00);

  delay(1000);

  Serial.println();
  Serial.println("========================================");
  Serial.println("       WEARABLE STROKE DETECTOR");
  Serial.println("========================================");

  Serial.print("Rower ID: ");
  Serial.println(ROWER_ID);

  Serial.println();

  Serial.println("Detection Settings");
  Serial.println("----------------------------------------");

  Serial.println("Minimum Duration : 500 ms");
  Serial.println("Maximum Duration : 2000 ms");
  Serial.println("Minimum Accel    : 4.0 m/s^2");
  Serial.println("Minimum Gyro     : 50.0 deg/s");

  Serial.println();

  Serial.println("Only VALID strokes will be sent.");
  Serial.println("Waiting for movement...");

  Serial.println();
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
  // ===================================================
  // READ ACCELEROMETER
  // ===================================================

  int16_t rawAX = read16(ACCEL_XOUT_H);
  int16_t rawAY = read16(ACCEL_XOUT_H + 2);
  int16_t rawAZ = read16(ACCEL_XOUT_H + 4);

  // ===================================================
  // READ GYROSCOPE
  // ===================================================

  int16_t rawGX = read16(GYRO_XOUT_H);
  int16_t rawGY = read16(GYRO_XOUT_H + 2);
  int16_t rawGZ = read16(GYRO_XOUT_H + 4);

  // ===================================================
  // ACCELEROMETER CALIBRATION
  // ===================================================

  float ax =
      (rawAX / ACCEL_SCALE_X) * GRAVITY;

  float ay =
      (rawAY / ACCEL_SCALE_Y) * GRAVITY;

  float zG =
      (rawAZ - Z_OFFSET) / Z_SCALE;

  float az =
      zG * GRAVITY;

  // ===================================================
  // GYROSCOPE CALIBRATION
  // ===================================================

  float gx =
      (rawGX / GYRO_SCALE) - GYRO_BIAS_X;

  float gy =
      (rawGY / GYRO_SCALE) - GYRO_BIAS_Y;

  float gz =
      (rawGZ / GYRO_SCALE) - GYRO_BIAS_Z;

  // ===================================================
  // ACCELERATION MAGNITUDE
  // ===================================================

  float accelerationMagnitude =
      sqrt(
        ax * ax +
        ay * ay +
        az * az
      );

  // Remove gravity

  float dynamicAcceleration =
      fabs(accelerationMagnitude - GRAVITY);

  // ===================================================
  // GYROSCOPE MAGNITUDE
  // ===================================================

  float gyroMagnitude =
      sqrt(
        gx * gx +
        gy * gy +
        gz * gz
      );

  // ===================================================
  // STROKE START
  // ===================================================

  if (!strokeActive)
  {
    bool strongAcceleration =
        dynamicAcceleration >= START_ACC_THRESHOLD;

    bool strongGyroscope =
        gyroMagnitude >= START_GYRO_THRESHOLD;

    if (strongAcceleration || strongGyroscope)
    {
      strokeActive = true;

      strokeStartTime = millis();

      peakAcceleration =
          dynamicAcceleration;

      peakGyroscope =
          gyroMagnitude;

      startAx = ax;
      startAy = ay;
      startAz = az;

      Serial.println();
      Serial.println(">>> POSSIBLE STROKE START <<<");
    }
  }

  // ===================================================
  // STROKE ACTIVE
  // ===================================================

  else
  {
    // -------------------------------------------------
    // UPDATE PEAK ACCELERATION
    // -------------------------------------------------

    if (dynamicAcceleration > peakAcceleration)
    {
      peakAcceleration =
          dynamicAcceleration;
    }

    // -------------------------------------------------
    // UPDATE PEAK GYROSCOPE
    // -------------------------------------------------

    if (gyroMagnitude > peakGyroscope)
    {
      peakGyroscope =
          gyroMagnitude;
    }

    // -------------------------------------------------
    // CALCULATE DURATION
    // -------------------------------------------------

    unsigned long duration =
        millis() - strokeStartTime;

    // -------------------------------------------------
    // CHECK WHETHER MOVEMENT STOPPED
    // -------------------------------------------------

    bool movementStopped =
        dynamicAcceleration < END_ACC_THRESHOLD &&
        gyroMagnitude < END_GYRO_THRESHOLD;

    // -------------------------------------------------
    // CHECK MAXIMUM DURATION
    // -------------------------------------------------

    bool timeout =
        duration >= MAX_STROKE_DURATION;

    // -------------------------------------------------
    // FINISH STROKE
    // -------------------------------------------------

    if (movementStopped || timeout)
    {
      // ===============================================
      // VALIDATION
      // ===============================================

      bool validDuration =
          duration >= MIN_STROKE_DURATION &&
          duration <= MAX_STROKE_DURATION;

      bool validAcceleration =
          peakAcceleration >= MIN_PEAK_ACC;

      bool validGyroscope =
          peakGyroscope >= MIN_PEAK_GYRO;

      // Both acceleration AND gyro required

      bool validStroke =
          validDuration &&
          validAcceleration &&
          validGyroscope;

      // ===============================================
      // ANGLE
      // ===============================================

      float angle =
          atan2(
            sqrt(
              startAx * startAx +
              startAy * startAy
            ),
            fabs(startAz)
          )
          * 180.0 / PI;

      // ===============================================
      // VALID STROKE
      // ===============================================

      if (validStroke)
      {
        strokeID++;

        Serial.println();
        Serial.println("========================================");
        Serial.println("           VALID STROKE");
        Serial.println("========================================");

        Serial.print("Stroke ID: ");
        Serial.println(strokeID);

        Serial.print("Duration: ");
        Serial.print(duration);
        Serial.println(" ms");

        Serial.print("Peak Acceleration: ");
        Serial.print(peakAcceleration, 3);
        Serial.println(" m/s^2");

        Serial.print("Peak Gyroscope: ");
        Serial.print(peakGyroscope, 3);
        Serial.println(" deg/s");

        Serial.print("Angle: ");
        Serial.print(angle, 2);
        Serial.println(" deg");

        Serial.println();

        // =============================================
        // CENTRAL ESP32 PACKET
        // =============================================

        Serial.print("STROKE,");
        Serial.print(ROWER_ID);
        Serial.print(",");
        Serial.print(strokeID);
        Serial.print(",");
        Serial.print(duration);
        Serial.print(",");
        Serial.print(peakAcceleration, 3);
        Serial.print(",");
        Serial.print(peakGyroscope, 3);
        Serial.print(",");
        Serial.println(angle, 2);

        Serial.println();

        Serial.println("Ready for next stroke...");
      }

      // ===============================================
      // INVALID STROKE
      // ===============================================

      else
      {
        Serial.println();
        Serial.println("========================================");
        Serial.println("          INVALID STROKE");
        Serial.println("========================================");

        Serial.print("Duration: ");
        Serial.print(duration);
        Serial.println(" ms");

        Serial.print("Peak Acceleration: ");
        Serial.print(peakAcceleration, 3);
        Serial.println(" m/s^2");

        Serial.print("Peak Gyroscope: ");
        Serial.print(peakGyroscope, 3);
        Serial.println(" deg/s");

        Serial.println();
        Serial.println("REASON:");

        // ---------------------------------------------
        // Duration
        // ---------------------------------------------

        if (duration < MIN_STROKE_DURATION)
        {
          Serial.print("- Duration too short (");
          Serial.print(duration);
          Serial.println(" ms < 500 ms)");
        }

        if (duration > MAX_STROKE_DURATION)
        {
          Serial.print("- Duration too long (");
          Serial.print(duration);
          Serial.println(" ms > 2000 ms)");
        }

        // ---------------------------------------------
        // Acceleration
        // ---------------------------------------------

        if (!validAcceleration)
        {
          Serial.print("- Acceleration too low (");
          Serial.print(peakAcceleration, 2);
          Serial.println(" < 4.0 m/s^2)");
        }

        // ---------------------------------------------
        // Gyroscope
        // ---------------------------------------------

        if (!validGyroscope)
        {
          Serial.print("- Gyroscope movement too low (");
          Serial.print(peakGyroscope, 2);
          Serial.println(" < 50.0 deg/s)");
        }

        Serial.println();

        Serial.println("Movement ignored.");
        Serial.println("No packet sent to Central ESP32.");

        Serial.println();
        Serial.println("Ready for next stroke...");
      }

      // ===============================================
      // RESET DETECTOR
      // ===============================================

      strokeActive = false;

      peakAcceleration = 0.0;
      peakGyroscope = 0.0;
    }
  }

  // ===================================================
  // 50 Hz SAMPLING
  // ===================================================

  delay(20);
}
