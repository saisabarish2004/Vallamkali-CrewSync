#include <Wire.h>

#define MPU_ADDR 0x68

#define ACCEL_XOUT_H 0x3B
#define PWR_MGMT_1   0x6B

int16_t read16(uint8_t reg) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, (uint8_t)2);

  if (Wire.available() < 2) {
    return 0;
  }

  return (Wire.read() << 8) | Wire.read();
}

void writeRegister(uint8_t reg, uint8_t value) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

void setup() {

  Serial.begin(115200);
  delay(2000);

  Wire.begin(21, 22);

  // Wake up MPU6050
  writeRegister(PWR_MGMT_1, 0x00);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("ACCELEROMETER X-UP TEST");
  Serial.println("================================");
  Serial.println("Keep sensor completely STILL");
  Serial.println("Collecting readings...");
  Serial.println();
}

void loop() {

  int16_t rawAX = read16(ACCEL_XOUT_H);
  int16_t rawAY = read16(ACCEL_XOUT_H + 2);
  int16_t rawAZ = read16(ACCEL_XOUT_H + 4);

  Serial.print("RAW AX: ");
  Serial.print(rawAX);

  Serial.print(" | RAW AY: ");
  Serial.print(rawAY);

  Serial.print(" | RAW AZ: ");
  Serial.println(rawAZ);

  delay(500);
}
