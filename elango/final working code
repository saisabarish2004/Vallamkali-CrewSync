#include <Wire.h>

// =====================================================
// MPU6050
// =====================================================

#define MPU_ADDR 0x68

#define ACCEL_XOUT_H 0x3B
#define GYRO_XOUT_H  0x43
#define PWR_MGMT_1   0x6B

// =====================================================
// ROWER ID
// Change this for each rower
// Rower 1 = 1
// Rower 2 = 2
// Rower 3 = 3
// =====================================================

#define ROWER_ID 1

// =====================================================
// MotionPacket
// =====================================================

struct MotionPacket {

  uint8_t rower_id;
  uint32_t sequence;
  uint32_t timestamp;

  float ax;
  float ay;
  float az;

  float gx;
  float gy;
  float gz;
};

// =====================================================
// Sequence counter
// =====================================================

uint32_t sequenceNumber = 0;

// =====================================================
// Calibration
// =====================================================

// Accelerometer
// X and Y are close to normal 1g scale.
// Z calibration was measured from your tests.

const float ACCEL_SCALE_X = 16384.0;
const float ACCEL_SCALE_Y = 16384.0;

const float Z_OFFSET = 3029.0;
const float Z_SCALE  = 16448.0;

// Gyroscope bias measured during your calibration

const float GYRO_BIAS_X = 1.93;
const float GYRO_BIAS_Y = 0.76;
const float GYRO_BIAS_Z = -0.27;

// MPU6050 gyro configured at ±250 deg/s
// Sensitivity = 131 LSB/(deg/s)

const float GYRO_SCALE = 131.0;

// Gravity

const float GRAVITY = 9.80665;

// =====================================================
// Read 16-bit signed value
// =====================================================

int16_t read16(uint8_t reg) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, (uint8_t)2);

  if (Wire.available() < 2) {
    return 0;
  }

  uint8_t highByte = Wire.read();
  uint8_t lowByte  = Wire.read();

  return (int16_t)((highByte << 8) | lowByte);
}

// =====================================================
// Write MPU6050 register
// =====================================================

void writeRegister(uint8_t reg, uint8_t value) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

// =====================================================
// Setup
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(2000);

  // XIAO ESP32 I2C pins used during your testing
  Wire.begin(21, 22);

  // Wake MPU6050
  writeRegister(PWR_MGMT_1, 0x00);

  delay(1000);

  Serial.println();
  Serial.println("========================================");
  Serial.println("   IMU MOTION PACKET SYSTEM");
  Serial.println("========================================");

  Serial.println("MPU6050 Address: 0x68");

  Serial.print("Rower ID: ");
  Serial.println(ROWER_ID);

  Serial.println("Sensor initialized.");
  Serial.println();
}

// =====================================================
// Main Loop
// =====================================================

void loop() {

  // ---------------------------------------------------
  // Read raw accelerometer
  // ---------------------------------------------------

  int16_t rawAX = read16(ACCEL_XOUT_H);
  int16_t rawAY = read16(ACCEL_XOUT_H + 2);
  int16_t rawAZ = read16(ACCEL_XOUT_H + 4);

  // ---------------------------------------------------
  // Read raw gyroscope
  // ---------------------------------------------------

  int16_t rawGX = read16(GYRO_XOUT_H);
  int16_t rawGY = read16(GYRO_XOUT_H + 2);
  int16_t rawGZ = read16(GYRO_XOUT_H + 4);

  // ---------------------------------------------------
  // Convert accelerometer
  // ---------------------------------------------------

  float ax = (rawAX / ACCEL_SCALE_X) * GRAVITY;

  float ay = (rawAY / ACCEL_SCALE_Y) * GRAVITY;

  // Z calibration
  float zG = (rawAZ - Z_OFFSET) / Z_SCALE;

  float az = zG * GRAVITY;

  // ---------------------------------------------------
  // Convert gyro and remove bias
  // ---------------------------------------------------

  float gx = (rawGX / GYRO_SCALE) - GYRO_BIAS_X;

  float gy = (rawGY / GYRO_SCALE) - GYRO_BIAS_Y;

  float gz = (rawGZ / GYRO_SCALE) - GYRO_BIAS_Z;

  // ---------------------------------------------------
  // Create MotionPacket
  // ---------------------------------------------------

  MotionPacket packet;

  packet.rower_id = ROWER_ID;

  packet.sequence = sequenceNumber++;

  packet.timestamp = millis();

  packet.ax = ax;
  packet.ay = ay;
  packet.az = az;

  packet.gx = gx;
  packet.gy = gy;
  packet.gz = gz;

  // ---------------------------------------------------
  // Print MotionPacket
  // ---------------------------------------------------

  Serial.println();
  Serial.println("========== MotionPacket ==========");

  Serial.print("Rower ID: ");
  Serial.println(packet.rower_id);

  Serial.print("Sequence: ");
  Serial.println(packet.sequence);

  Serial.print("Timestamp: ");
  Serial.println(packet.timestamp);

  Serial.println();

  Serial.println("Accelerometer:");

  Serial.print("AX: ");
  Serial.print(packet.ax, 3);
  Serial.println(" m/s^2");

  Serial.print("AY: ");
  Serial.print(packet.ay, 3);
  Serial.println(" m/s^2");

  Serial.print("AZ: ");
  Serial.print(packet.az, 3);
  Serial.println(" m/s^2");

  Serial.println();

  Serial.println("Gyroscope:");

  Serial.print("GX: ");
  Serial.print(packet.gx, 3);
  Serial.println(" deg/s");

  Serial.print("GY: ");
  Serial.print(packet.gy, 3);
  Serial.println(" deg/s");

  Serial.print("GZ: ");
  Serial.print(packet.gz, 3);
  Serial.println(" deg/s");

  Serial.println("===================================");

  // ---------------------------------------------------
  // Sampling interval
  // ---------------------------------------------------

  delay(100);
}
