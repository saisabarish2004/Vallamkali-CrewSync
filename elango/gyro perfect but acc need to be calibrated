#include <Wire.h>

#define MPU_ADDR 0x68

#define GYRO_XOUT_H 0x43
#define PWR_MGMT_1  0x6B

int16_t read16(uint8_t reg) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, (uint8_t)2);

  if (Wire.available() < 2) {
    return 0;
  }

  return (Wire.read() << 8) | Wire.read();
}

void writeRegister(uint8_t reg, uint8_t value) {

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

void setup() {

  Serial.begin(115200);
  delay(2000);

  Wire.begin(21, 22);

  // Wake up MPU6050
  writeRegister(PWR_MGMT_1, 0x00);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("GYROSCOPE CALIBRATION");
  Serial.println("================================");
  Serial.println("Keep MPU6050 COMPLETELY STILL");
  Serial.println("Collecting 1000 samples...");
  Serial.println();

  delay(3000);

  long sumGX = 0;
  long sumGY = 0;
  long sumGZ = 0;

  const int samples = 1000;

  for (int i = 0; i < samples; i++) {

    int16_t rawGX = read16(GYRO_XOUT_H);
    int16_t rawGY = read16(GYRO_XOUT_H + 2);
    int16_t rawGZ = read16(GYRO_XOUT_H + 4);

    sumGX += rawGX;
    sumGY += rawGY;
    sumGZ += rawGZ;

    delay(5);
  }

  float avgRawGX = (float)sumGX / samples;
  float avgRawGY = (float)sumGY / samples;
  float avgRawGZ = (float)sumGZ / samples;

  float biasGX = avgRawGX / 131.0;
  float biasGY = avgRawGY / 131.0;
  float biasGZ = avgRawGZ / 131.0;

  Serial.println("========== RESULT ==========");

  Serial.print("Raw GX Average: ");
  Serial.println(avgRawGX, 2);

  Serial.print("Raw GY Average: ");
  Serial.println(avgRawGY, 2);

  Serial.print("Raw GZ Average: ");
  Serial.println(avgRawGZ, 2);

  Serial.println();

  Serial.print("GX Bias: ");
  Serial.print(biasGX, 4);
  Serial.println(" deg/s");

  Serial.print("GY Bias: ");
  Serial.print(biasGY, 4);
  Serial.println(" deg/s");

  Serial.print("GZ Bias: ");
  Serial.print(biasGZ, 4);
  Serial.println(" deg/s");

  Serial.println("============================");
}

void loop() {
}
